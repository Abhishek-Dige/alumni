# ================================
# 🌐 DATABASE CONFIGURATION 
# ================================

# Local development MongoDB
# MONGODB_URI=mongodb://localhost:27017/iiitl-alumni

# MongoDB Atlas (production example)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/iiitl-alumni


# ================================
# 🔐 AUTH CONFIGURATION (NextAuth)
# ================================

# Base URL of the application
# NEXTAUTH_URL=http://localhost:3000

# Secret for signing tokens (generate using: openssl rand -base64 32)
# NEXTAUTH_SECRET=your_nextauth_secret_here


# ================================
# 📧 EMAIL (MAGIC LINK LOGIN)
# ================================

# SMTP connection string format:
# smtp://<email>:<app_password>@smtp.gmail.com:587

# Example (Gmail with App Password):
# EMAIL_SERVER=smtp://your_email@gmail.com:your_app_password@smtp.gmail.com:587

# Sender email address
# EMAIL_FROM=your_email@gmail.com


# ================================
# 🔵 GOOGLE OAUTH CONFIGURATION
# ================================

# Get these from Google Cloud Console:
# https://console.cloud.google.com/

# GOOGLE_ID=your_google_client_id
# GOOGLE_SECRET=your_google_client_secret